# ESLint 10 (21 Oct 2026, DO-THIS-NEXT W59). Two plugins the Next.js lint preset
# pulls in -- eslint-plugin-import and eslint-plugin-jsx-a11y -- still declare
# support only up to ESLint 9, though they work under 10; npm would refuse the
# install on that declaration alone. This line tells npm to install what the
# lock file says and not to refuse on declared ranges. The cost is that npm no
# longer checks peer ranges for any package here, and no longer installs a
# missing peer by itself (which is why typescript is now listed explicitly).
# Remove this file the day both plugins publish ESLint 10 support.
legacy-peer-deps=true
